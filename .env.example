# Copy to .env and fill in what you need. .env is gitignored.

# --- Search connector (only for `--connector brave`) --------------------
# Free tier: https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# --- Briefing synthesis (only for `--brief llm` / `--brief auto`) -------
# Pick ONE provider. Default provider is gemini; override with LLM_PROVIDER.
LLM_PROVIDER=gemini
# LLM_MODEL=                       # optional; per-provider default otherwise

# gemini  -- free tier, no card: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# anthropic -- https://console.anthropic.com/
# ANTHROPIC_API_KEY=
# openai -- https://platform.openai.com/api-keys
# OPENAI_API_KEY=
